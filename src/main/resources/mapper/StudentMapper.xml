<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--namespace:命令空间。现在可以随便起名。
后续需要和dao的名称一致。
-->
<mapper namespace="com.aaa.sm.dao.StudentDao">

    <!--列名和属于名之间的映射：-->
    <resultMap id="StudentMapper" type="Student">
        <id column="id" property="id"/>
        <result column="student_no" property="no"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="birthday" property="birthday" javaType="DATE"/>
        <result column="class_id" property="classId"/>
        <result column="phone" property="phone"/>
        <!--association: 一对一或多对一的映射关系
        property: 表示对应对象的属性名
        javaType: 表示对象的类型
        注意：班级表的id在查询时别名为cid，避免和学生表的id列名冲突
        -->
        <association property="clazz" javaType="Clazz">
            <id column="cid" property="cid"/>
            <result column="class_name" property="name"/>
            <result column="grade" property="grade"/>
            <result column="head_teacher" property="teacher"/>
            <result column="room" property="room"/>
        </association>
    </resultMap>

    <!--查询条件复用-->
    <!--suppress SqlResolve -->
    <sql id="queryCondition">
        <where>
            <if test="name != null and name != ''">
                and s.name like concat('%', #{name}, '%')
            </if>
            <if test="className != null and className != ''">
                and c.class_name like concat('%', #{className}, '%')
            </if>
        </where>
    </sql>

    <select id="getById" resultMap="StudentMapper">
        select s.id, s.student_no, s.name, s.gender, s.birthday,
               s.class_id, s.phone,
               c.id as cid, c.class_name, c.grade, c.head_teacher, c.room
        from student s
        left join class c on s.class_id = c.id
        where s.id = #{id}
    </select>

    <!--条件查询：分页由PageHelper插件拦截并自动拼接limit，这里不要写limit-->
    <select id="list" resultMap="StudentMapper">
        select s.id, s.student_no, s.name, s.gender, s.birthday,
               s.class_id, s.phone,
               c.id as cid, c.class_name, c.grade, c.head_teacher, c.room
        from student s
        left join class c on s.class_id = c.id
        <include refid="queryCondition"/>
        order by s.id asc
    </select>

    <!--insert: 新增学生操作-->
    <insert id="insert" >
        insert into student(student_no, name, gender, birthday, class_id, phone)
        values(#{no}, #{name}, #{gender}, #{birthday}, #{classId}, #{phone})
    </insert>

    <!--update: 修改学生操作，用set+if实现按需更新，没传的字段保持原值-->
    <update id="update">
        update student
        <set>
            <if test="no != null and no != ''">
                student_no = #{no},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="gender != null and gender != ''">
                gender = #{gender},
            </if>
            <if test="birthday != null">
                birthday = #{birthday},
            </if>
            <if test="classId != null">
                class_id = #{classId},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
        </set>
        where id = #{id}
    </update>

    <!--delete: 删除学生操作-->
    <delete id="deleteById">
        delete from student where id = #{id}
    </delete>

    <!--统计某个班级下的学生数量（删除班级前校验外键）-->
    <select id="countByClassId" resultType="int">
        select count(*) from student where class_id = #{classId}
    </select>
</mapper>