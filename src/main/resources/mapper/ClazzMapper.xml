<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--namespace:命令空间。现在可以随便起名。
后续需要和dao的名称一致。
-->
<mapper namespace="com.aaa.sm.dao.ClazzDao">

    <!--列名和属于名之间的映射：-->
    <resultMap id="ClazzMapper" type="Clazz">
        <id column="id" property="cid"/>
        <result column="class_name" property="name"/>
        <result column="grade" property="grade"/>
        <result column="head_teacher" property="teacher"/>
    </resultMap>

    <select id="getById" resultMap="ClazzMapper">
        select * from class where id=#{id}
    </select>
</mapper>